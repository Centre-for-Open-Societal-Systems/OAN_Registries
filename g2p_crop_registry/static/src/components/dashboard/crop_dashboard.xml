<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="crop_registry.Dashboard" owl="1">
        <div class="crop-dashboard-container p-4 h-100 overflow-auto">
            <div class="d-flex justify-content-between align-items-center mb-4 dashboard-header">
                <h2 class="m-0 text-primary fw-bold">Crop Sown Registry Dashboard</h2>
                <button class="btn btn-danger export-pdf-btn" t-on-click="exportPDF">
                    <i class="fa fa-file-pdf-o me-2"></i> Export PDF
                </button>
            </div>

            <!-- Filter Section -->
            <div class="filter-section bg-white p-3 rounded shadow-sm mb-4">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label text-muted small">Season</label>
                        <select class="form-select form-select-sm" t-model="state.filters.season_id" t-on-change="onFilterChange">
                            <option value="">All Seasons</option>
                            <t t-foreach="state.options.seasons" t-as="season" t-key="season.id">
                                <option t-att-value="season.id"><t t-esc="season.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small">Region</label>
                        <select class="form-select form-select-sm" t-model="state.filters.region_id" t-on-change="onFilterChange">
                            <option value="">All Regions</option>
                            <t t-foreach="state.options.regions" t-as="region" t-key="region.id">
                                <option t-att-value="region.id"><t t-esc="region.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small">Zone</label>
                        <select class="form-select form-select-sm" t-model="state.filters.zone_id" t-on-change="onFilterChange">
                            <option value="">All Zones</option>
                            <t t-foreach="state.options.zones" t-as="zone" t-key="zone.id">
                                <option t-att-value="zone.id"><t t-esc="zone.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small">Woreda</label>
                        <select class="form-select form-select-sm" t-model="state.filters.woreda_id" t-on-change="onFilterChange">
                            <option value="">All Woredas</option>
                            <t t-foreach="state.options.woredas" t-as="woreda" t-key="woreda.id">
                                <option t-att-value="woreda.id"><t t-esc="woreda.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small">Crop</label>
                        <select class="form-select form-select-sm" t-model="state.filters.crop_id" t-on-change="onFilterChange">
                            <option value="">All Crops</option>
                            <t t-foreach="state.options.crops" t-as="crop" t-key="crop.id">
                                <option t-att-value="crop.id"><t t-esc="crop.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-secondary btn-sm w-100" t-on-click="clearFilters">
                            <i class="fa fa-refresh me-1"></i> Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="kpi-card bg-white p-4 rounded shadow-sm d-flex flex-column h-100">
                        <span class="text-muted text-uppercase small fw-bold mb-2">Planned Crop Area</span>
                        <h3 class="text-primary mb-0"><t t-esc="state.stats.total_planned_crop_area"/> <small class="text-muted fs-6">HA</small></h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="kpi-card bg-white p-4 rounded shadow-sm d-flex flex-column h-100">
                        <span class="text-muted text-uppercase small fw-bold mb-2">Expected Yield</span>
                        <h3 class="text-success mb-0"><t t-esc="state.stats.total_expected_yield"/> <small class="text-muted fs-6">Quintals</small></h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="kpi-card bg-white p-4 rounded shadow-sm d-flex flex-column h-100">
                        <span class="text-muted text-uppercase small fw-bold mb-2">Actual Yield</span>
                        <h3 class="text-info mb-0"><t t-esc="state.stats.total_actual_yield"/> <small class="text-muted fs-6">Quintals</small></h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="kpi-card bg-white p-4 rounded shadow-sm d-flex flex-column h-100">
                        <span class="text-muted text-uppercase small fw-bold mb-2">Ratio Sown</span>
                        <h3 class="text-warning mb-0"><t t-esc="state.stats.ratio_planned"/>%</h3>
                    </div>
                </div>
            </div>

            <!-- Charts Section 1 -->
            <div class="row g-4 mb-4" id="pdf-charts-section-1">
                <div class="col-md-8">
                    <div class="chart-container bg-white p-4 rounded shadow-sm h-100">
                        <h5 class="text-muted mb-4">Planned vs Actual Yield by Crop</h5>
                        <div style="position: relative; height: 350px;">
                            <canvas id="yieldChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="chart-container bg-white p-4 rounded shadow-sm h-100">
                        <h5 class="text-muted mb-4">Top 5 Crops by Area</h5>
                        <div style="position: relative; height: 350px;">
                            <canvas id="areaChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section 2 (New) -->
            <div class="row g-4 mb-4" id="pdf-charts-section-2">
                <div class="col-md-6">
                    <div class="chart-container bg-white p-4 rounded shadow-sm h-100">
                        <h5 class="text-muted mb-4">Planned vs Actual Area by Crop</h5>
                        <div style="position: relative; height: 350px;">
                            <canvas id="areaCompChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="chart-container bg-white p-4 rounded shadow-sm h-100">
                        <h5 class="text-muted mb-4">Yield Comparison by Region</h5>
                        <div style="position: relative; height: 350px;">
                            <canvas id="regionYieldChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PDF Hidden Template -->
            <div id="pdf-export-content" class="d-none">
                <div class="pdf-header text-center mb-4">
                    <h2>Crop Sown Registry Report</h2>
                    <p class="text-muted">Generated from Dashboard Data</p>
                </div>
                <div class="pdf-filters mb-4">
                    <!-- Dynamic filters inserted here by JS -->
                </div>
                <!-- Images of charts will be inserted here -->
                <div class="pdf-charts-container mb-4"></div>
                <div class="pdf-table-container">
                    <!-- Dynamic table inserted here by JS -->
                </div>
            </div>
        </div>
    </t>
</templates>
