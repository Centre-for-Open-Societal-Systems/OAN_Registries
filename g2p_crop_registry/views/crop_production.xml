<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>


        <record id="seq_g2p_crop_production" model="ir.sequence">
            <field name="name">Crop Production</field>
            <field name="code">g2p.crop.production</field>
            <field name="prefix">PROD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>


        <record id="view_crop_production_tree" model="ir.ui.view">
            <field name="name">g2p.crop.production.tree</field>
            <field name="model">g2p.crop.production</field>
            <field name="arch" type="xml">
                <tree string="Production" create="0">
                    <field name="name" />
                    <field name="reg_farmer_id" />
                    <field name="reg_farmer_display_id" />
                    <field name="crop_name_id" />
                    <field name="sowing_status" />
                    <field name="cluster_status_ids" widget="many2many_tags" />
                    <field name="area_sown" />

                    <field name="actual_sowing_date" />
                    <field name="harvest_date" optional="show" />
                    <field name="qty_harvested" optional="show" />
                    <field name="yield_per_ha" optional="show" />
                    <field name="yield_performance_pct" optional="show" />

                    <field name="crop_registry_id" column_invisible="1" />
                </tree>
            </field>
        </record>


        <record id="view_crop_production_form" model="ir.ui.view">
            <field name="name">g2p.crop.production.form</field>
            <field name="model">g2p.crop.production</field>
            <field name="arch" type="xml">
                <form string="Production">
                    <sheet>


                        <div class="oe_title">
                            <label for="name" string="Reference" />
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                            <div class="o_row">
                                <label for="season_id" string="Season" />
                                <field name="season_id" readonly="1" />
                                <label for="crop_name_id" string="Crop Name" />
                                <field name="crop_name_id" readonly="1" />
                            </div>
                            <div class="o_row">
                            </div>
                        </div>


                        <field name="crop_registry_id" invisible="1" />


                        <group string="Farmer Identity">
                            <group>
                                <field name="reg_farmer_id" readonly="1" />
                                <field name="reg_fyda_id" readonly="1" />
                                <field name="reg_farmer_display_id" readonly="1" invisible="1" />
                            </group>
                            <group>
                                <field name="reg_region_name_id" readonly="1" invisible="1" />
                                <field name="reg_zone_name_id" readonly="1" invisible="1" />
                                <field name="reg_woreda_name_id" readonly="1" invisible="1" />
                                <field name="reg_kebele_id" readonly="1" invisible="1" />
                            </group>
                        </group>


                        <group string="Land / Plot Details">
                            <group>
                                <field name="is_plot_not_registered" invisible="land_info_id" />
                                <field name="land_info_id" readonly="1" invisible="is_plot_not_registered" />
<field name="temporary_land_id" invisible="not is_plot_not_registered" style="font-style: italic;" />
<field name="land_total_area" readonly="not is_plot_not_registered" />
                                <field name="land_ownership_type" readonly="not is_plot_not_registered" />
                            </group>
                            <group>
                                <field name="land_region_id" readonly="not is_plot_not_registered" />

                            </group>
                        </group>


                        <group string="Cultivation / Land Preparation section">
                            <group>
                                <field name="crop_name_id" readonly="1" />
                                <field name="crop_category_id" readonly="1" />
                                <field name="actual_seed_class" readonly="1" />
                            </group>
                            <group>
                                <field name="actual_fertilizer_qty" readonly="1" />
                                <field name="cultivated_by" readonly="1" />
                            </group>
                        </group>

                        <notebook>


                            <page string="Sowing">
                                <group string="Sowing Details">
                                    <group>
                                        <field name="sowing_status" readonly="1" />
                                        <field name="cluster_status_ids" widget="many2many_tags" readonly="1" />
                                        <field name="area_sown" readonly="1" />
                                        <field name="actual_sowing_date" readonly="1" invisible="not is_independent" />
                                        <field name="has_pest_disease" widget="boolean_toggle" readonly="1" />
                                        <field name="is_clustered" invisible="1" />
                                        <field name="is_independent" invisible="1" />
                                    </group>
                                </group>


                                <group string="Pest / Disease Details" invisible="not is_independent or not has_pest_disease">
                                    <field name="infestation_incident_ids" nolabel="1" colspan="2" readonly="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="name" />
                                            <field name="growth_stage" />
                                            <field name="infestation_type_ids" widget="many2many_tags" />
                                            <field name="severity_level" />
                                        </tree>
                                        <form string="Infestation Incident" create="0" edit="0">
                                            <sheet>
                                                <div class="oe_title">
                                                    <h1><field name="name" /></h1>
                                                </div>
                                                <group>
                                                    <group>
                                                        <field name="crop_name_id" />
                                                        <field name="infestation_type_ids" widget="many2many_tags" />
                                                        <field name="growth_stage" />
                                                    </group>
                                                    <group>
                                                        <field name="observation_date" />
                                                        <field name="observation_date_ec" />
                                                        <field name="severity_level" />
                                                        <field name="estimated_damage" placeholder="e.g., 50% or 1.5 (for ha)" />
                                                        <field name="geo_tagged_photo" widget="image" invisible="severity_level != 'high'" required="severity_level == 'high'" />
                                                    </group>
                                                </group>

                                                <field name="is_pest" invisible="1" />
                                                <field name="is_weed" invisible="1" />
                                                <field name="is_disease" invisible="1" />

                                                <notebook>
                                                    <page string="Pest Occurrence" invisible="not is_pest">
                                                        <field name="pest_line_ids" nolabel="1" colspan="2">
                                                            <tree editable="bottom">
                                                                <field name="pest_type" />
                                                                <field name="pest_name" />
                                                                <field name="pesticide_method" />
                                                                <field name="pesticide_type" />
                                                                <field name="pesticide_name" />
                                                                <field name="pesticide_frequency" />
                                                            </tree>
                                                        </field>
                                                    </page>
                                                    <page string="Weed Occurrence" invisible="not is_weed">
                                                        <field name="weed_line_ids" nolabel="1" colspan="2">
                                                            <tree editable="bottom">
                                                                <field name="weed_type" />
                                                                <field name="weed_name" />
                                                                <field name="pesticide_method" />
                                                                <field name="weedicide_type" />
                                                                <field name="weedicide_name" />
                                                                <field name="pesticide_frequency" />
                                                            </tree>
                                                        </field>
                                                    </page>
                                                    <page string="Disease" invisible="not is_disease">
                                                        <field name="disease_line_ids" nolabel="1" colspan="2">
                                                            <tree editable="bottom">
                                                                <field name="disease_type" />
                                                                <field name="disease_name" />
                                                                <field name="method_of_control" />
                                                                <field name="fungicide_type" />
                                                                <field name="fungicide_name" />
                                                                <field name="frequency_of_application" />
                                                            </tree>
                                                        </field>
                                                    </page>
                                                </notebook>

                                                <group>
                                                    <field name="action_taken" invisible="1" />
                                                </group>
                                            </sheet>
                                        </form>
                                    </field>
                                </group>

                                <group string="Clustered Details" invisible="not is_clustered">
                                    <field name="production_cluster_line_ids" nolabel="1" colspan="2">
                                        <tree>
                                            <field name="cluster_info_id" string="Cluster ID" options="{'no_create': True, 'no_open': True}" />
                                            <field name="cluster_name" readonly="1" force_save="1" />
                                            <field name="sowing_status" />
                                            <field name="area_sown" />
                                            <field name="has_pest_disease" widget="boolean_toggle" />
                                            <field name="season_id" readonly="1" force_save="1" />
                                            <field name="cluster_agro_ecological_zone" readonly="1" force_save="1" />
                                            <field name="cluster_area_hectare" readonly="1" force_save="1" />
                                        </tree>
                                        <form string="Cluster Details">
                                            <sheet>
                                                <group>
                                                    <group>
                                                        <field name="cluster_info_id" string="Cluster ID" options="{'no_create': True, 'no_open': True}" />
                                                        <field name="cluster_name" readonly="1" force_save="1" />
                                                        <field name="season_id" readonly="1" force_save="1" />
                                                        <field name="cluster_agro_ecological_zone" readonly="1" force_save="1" />
                                                    </group>
                                                    <group>
                                                        <field name="sowing_status" />
                                                        <field name="area_sown" />
                                                        <field name="has_pest_disease" widget="boolean_toggle" readonly="1" />
                                                        <field name="cluster_area_hectare" readonly="1" force_save="1" />
                                                    </group>
                                                </group>

                                                <group string="Pest / Disease Details" invisible="not has_pest_disease">
                                                    <field name="infestation_incident_ids" nolabel="1" colspan="2" readonly="1">
                                                        <tree create="0" edit="0" delete="0">
                                                            <field name="name" />
                                                            <field name="growth_stage" />
                                                            <field name="infestation_type_ids" widget="many2many_tags" />
                                                            <field name="severity_level" />
                                                        </tree>
                                                        <form string="Infestation Incident" create="0" edit="0">
                                                            <sheet>
                                                                <div class="oe_title">
                                                                    <h1><field name="name" /></h1>
                                                                </div>
                                                                <group>
                                                                    <group>
                                                                        <field name="crop_name_id" />
                                                                        <field name="infestation_type_ids" widget="many2many_tags" />
                                                                        <field name="growth_stage" />
                                                                    </group>
                                                                    <group>
                                                                        <field name="observation_date" />
                                                                        <field name="observation_date_ec" />
                                                                        <field name="severity_level" />
                                                                        <field name="estimated_damage" placeholder="e.g., 50% or 1.5 (for ha)" />
                                                                        <field name="geo_tagged_photo" widget="image" invisible="severity_level != 'high'" required="severity_level == 'high'" />
                                                                    </group>
                                                                </group>

                                                                <field name="is_pest" invisible="1" />
                                                                <field name="is_weed" invisible="1" />
                                                                <field name="is_disease" invisible="1" />

                                                                <notebook>
                                                                    <page string="Pest Occurrence" invisible="not is_pest">
                                                                        <field name="pest_line_ids" nolabel="1" colspan="2">
                                                                            <tree editable="bottom">
                                                                                <field name="pest_type" />
                                                                                <field name="pest_name" />
                                                                                <field name="pesticide_method" />
                                                                                <field name="pesticide_type" />
                                                                                <field name="pesticide_name" />
                                                                                <field name="pesticide_frequency" />
                                                                            </tree>
                                                                        </field>
                                                                    </page>
                                                                    <page string="Weed Occurrence" invisible="not is_weed">
                                                                        <field name="weed_line_ids" nolabel="1" colspan="2">
                                                                            <tree editable="bottom">
                                                                                <field name="weed_type" />
                                                                                <field name="weed_name" />
                                                                                <field name="pesticide_method" />
                                                                                <field name="weedicide_type" />
                                                                                <field name="weedicide_name" />
                                                                                <field name="pesticide_frequency" />
                                                                            </tree>
                                                                        </field>
                                                                    </page>
                                                                    <page string="Disease" invisible="not is_disease">
                                                                        <field name="disease_line_ids" nolabel="1" colspan="2">
                                                                            <tree editable="bottom">
                                                                                <field name="disease_type" />
                                                                                <field name="disease_name" />
                                                                                <field name="method_of_control" />
                                                                                <field name="fungicide_type" />
                                                                                <field name="fungicide_name" />
                                                                                <field name="frequency_of_application" />
                                                                            </tree>
                                                                        </field>
                                                                    </page>
                                                                </notebook>

                                                                <group>
                                                                    <field name="action_taken" invisible="1" />
                                                                </group>
                                                            </sheet>
                                                        </form>
                                                    </field>
                                                </group>
                                            </sheet>
                                        </form>
                                    </field>
                                </group>
                            </page>


                            <page string="Harvest" invisible="sowing_status != 'sown'">
                                <group string="Harvest Details">
                                    <group>
                                        <field name="crop_maturity_status" decoration-success="crop_maturity_status == 'green'" decoration-warning="crop_maturity_status == 'yellow'" readonly="1" />
                                        <field name="harvest_date" readonly="1" />
                                        <field name="area_harvested" readonly="1" />
                                        <field name="qty_harvested" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="post_harvest_loss_pct" readonly="1" />
                                        <field name="qty_stored" readonly="1" />
                                        <field name="qty_sold" readonly="1" />
                                    </group>
                                </group>
                            </page>


                            <page string="Production Result" invisible="sowing_status != 'sown'">
                                <group string="Computed Outputs" colspan="2">
                                    <group>
                                        <field name="yield_per_ha" readonly="1" />
                                        <field name="yield_performance_pct" readonly="1" />
                                        <field name="fertilizer_efficiency" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="land_utilization_rate" readonly="1" />
                                        <field name="seed_productivity" readonly="1" />
                                    </group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_g2p_crop_production" model="ir.actions.act_window">
            <field name="name">Production</field>
            <field name="res_model">g2p.crop.production</field>
            <field name="view_mode">tree,form</field>
        </record>


        <menuitem id="menu_g2p_crop_production" name="Production" parent="g2p_crop_registry.g2p_crop_registry_menu_item_id" action="action_g2p_crop_production" sequence="55" groups="g2p_crop_registry.group_woreda_agri_office_head" />

    </data>
</odoo>
