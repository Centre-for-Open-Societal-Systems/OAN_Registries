        <field name="target_registry">g2p.crop.registry.planning</field>
        <field name="json_formatter">{
  "submission_time": .__system.submissionDate,

  "farmer_identity": {
    "fyda_id": .farmer_identity.fyda_id,
    "farmer_display_id": .farmer_identity.farmer_display_id,
    "region_display_id": .farmer_identity.region_display_id,
    "zone_display_id": .farmer_identity.zone_display_id,
    "woreda_id": .farmer_identity.woreda_id,
    "kebele_id": .farmer_identity.kebele_id,
    "gps": .farmer_identity.gps
  },

  "planning": (.planning // [] | map({

    "is_plot_not_registered": .is_plot_not_registered,
    "land_info_id": .land_info_id,
    "land_category": .land_category,
    "ownership_type": .ownership_type,
    "land_area": .land_area,

    "region": .region_name_id,
    "zone": .zone_name_id,
    "woreda": .woreda_name_id,
    "kebele": .kebele_id,
    "soil_fertility": .soil_fertility,
    "gps": .gps,

    "season_details": {
      "season": .season_details.season_id
    },

    "crop_details": {
      "crop": .crop_details.crop_name_id,
      "crop_category": .crop_details.crop_category_id,
      "local_name": .crop_details.local_name,
      "scientific_name": .crop_details.scientific_name,
      "crop_variety": .crop_details.crop_variety_id,
      "cropping_system": .crop_details.cropping_system,
      "planned_date_gc": .crop_details.collected_gc,
      "planned_date_ec": .crop_details.collected_ec
    },

    "crop_planned_inputs": {
      "avg_growth_duration_days": .crop_planned_inputs.crop_growth_duration,
      "planned_crop_area_ha": .crop_planned_inputs.crop_planned_area,
      "expected_yield_quintal": .crop_planned_inputs.crop_expected
    },

    "seed_planned_inputs": {
      "seed_type": .seed_planned_inputs.seed_planned,
      "seed_source": .seed_planned_inputs.seed_source,
      "planned_seed_qty_kg": .seed_planned_inputs.seed_planned_qty,
      "planned_fertilizer_type": .seed_planned_inputs.seed_planned_fertilizer_type,
      "planned_fertilizer_qty_kg": .seed_planned_inputs.seed_planned_fertilizer_qty,
      "planned_labor": .seed_planned_inputs.planned_labor
    },

    "water_details": .water_details,
    "has_cluster_farming": .has_cluster.has_cluster_farming,

    "cluster_information": {
      "cluster_name": .cluster_information.cluster_name,
      "season_id": .cluster_information.season_id,
      "agro_ecological_zone": .cluster_information.cluster_agro_ecological_zone,
      "sub_kebele": .cluster_information.sub_kebele
    },

    "cultivation_details": {
      "cluster_area_timad": .cluster_information.cultivation_details.cluster_area_timad,
      "cluster_area_hectare": .cluster_information.cultivation_details.cluster_area_hectare,
      "cluster_plan": .cluster_information.cultivation_details.cluster_plan,
      "collected_land_quintal": .cluster_information.cultivation_details.collected_land_quintal,
      "cluster_collected_land_quintal": .cluster_information.cultivation_details.cluster_collected_quintal,
      "collected_by_combiner": .cluster_information.cultivation_details.collected_by_combiner
    },

    "water_details_1": .cluster_information.water_details_1,
    "cluster_smallholders": .cluster_information.cluster_smallholders,
    "farmer_list": (.farmer_list // .cluster_information.farmer_list // []),
    
    "survey_personnel": {
      "surveyor_name": .survey_personnel.surveyor_name,
      "surveyor_mobile_number": .survey_personnel.surveyor_mobile_number,
      "supervisor_name": .survey_personnel.supervisor_name,
      "supervisor_mobile_number": .survey_personnel.supervisor_mobile_number
    }

  })),

