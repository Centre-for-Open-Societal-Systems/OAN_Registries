<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_g2p_livestock_registry_line_search" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.search</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="ear_tag_id" string="Ear Tag"/>
                <field name="owner_id" string="Owner"/>
                <field name="species_id"/>                    <!-- Updated -->
                <field name="breed"/>

                <filter string="Healthy" name="filter_healthy" domain="[('health_status','=','healthy')]"/>
                <filter string="Sick" name="filter_sick" domain="[('health_status','=','sick')]"/>
                <filter string="Quarantined" name="filter_quarantined" domain="[('health_status','=','quarantined')]"/>
                <separator/>
                <filter string="Vaccination Overdue" name="filter_overdue" domain="[('vaccination_status','=','overdue')]"/>

                <group expand="0" string="Group By">
                    <filter string="Species" name="group_species" context="{'group_by': 'species_id'}"/>   <!-- Updated -->
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                    <filter string="Health Status" name="group_health" context="{'group_by': 'health_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_g2p_livestock_registry_line_tree" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.tree</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" create="false">
                <field name="ear_tag_id" string="Ear Tag"/>
                <field name="owner_id" string="Owner"/>
                <field name="species_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>                    <!-- Updated -->
                <field name="breed"/>
                <field name="gender"/>
                <field name="weight"/>
                <field name="health_status" widget="badge" readonly="1"
                       decoration-success="health_status == 'healthy'"
                       decoration-warning="health_status == 'sick'"
                       decoration-danger="health_status in ('quarantined', 'deceased')"/>
                <field name="vaccination_status" widget="badge" readonly="1"
                       decoration-success="vaccination_status == 'up_to_date'"
                       decoration-warning="vaccination_status == 'overdue'"
                       decoration-muted="vaccination_status == 'none'"/>
                <field name="age"/>
                <field name="registration_date"/>
                <field name="registry_id" string="Farmer Record"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_g2p_livestock_registry_line_form" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.form</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="ear_tag_id" placeholder="Ear Tag"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="registry_id" string="Farmer Record" readonly="1"/>
                            <field name="owner_id" readonly="1"/>
                            <field name="species_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>                    <!-- Updated -->
                            <field name="breed"/>
                            <field name="gender"/>
                            <field name="weight"/>
                        </group>
                        <group>
                            <field name="health_status" readonly="1"/>
                            <field name="vaccination_status" readonly="1"/>
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                            <field name="registration_date"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not id">
                        Health Status and Vaccination Status can only be changed by logging a
                        Health Event or Vaccination record on this animal's Farmer page — not
                        edited directly here — so every status change stays traceable to a
                        real event, date, and reason.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_g2p_livestock_registry_line" model="ir.actions.act_window">
        <field name="name">Animals</field>
        <field name="res_model">g2p.livestock.registry.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_g2p_livestock_registry_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Every individual animal shows up here — one row per animal,
                even if several animals belong to the same farmer record.
            </p>
        </field>
    </record>

    <!-- Server action: Bulk Export -->
    <record id="server_action_animal_bulk_export" model="ir.actions.server">
        <field name="name">Bulk Export to Excel</field>
        <field name="model_id" ref="model_g2p_livestock_registry_line"/>
        <field name="binding_model_id" ref="model_g2p_livestock_registry_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_export()</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_livestock_animals"
              name="Animals"
              parent="g2p_livestock_registry_menu_item_id"
              action="action_g2p_livestock_registry_line"
              sequence="2"/>

</odoo>