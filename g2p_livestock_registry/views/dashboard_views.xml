<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot View -->
    <record id="g2p_livestock_registry_pivot" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.pivot</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <pivot string="Livestock Statistics" sample="1">
                <field name="species_id" type="row"/>        <!-- Updated -->
                <field name="health_status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Graph: Species / Health distribution -->
    <record id="g2p_livestock_registry_graph" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.graph</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <graph string="Livestock Distribution" type="bar" stacked="True">
                <field name="species_id"/>                   <!-- Updated -->
                <field name="health_status"/>
            </graph>
        </field>
    </record>

    <!-- Graph: Vaccination compliance -->
    <record id="g2p_livestock_registry_graph_vaccination" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.graph.vaccination</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <graph string="Vaccination Compliance" type="pie">
                <field name="vaccination_status"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: Demographics -->
    <record id="g2p_livestock_registry_pivot_demographics" model="ir.ui.view">
        <field name="name">g2p.livestock.registry.line.pivot.demographics</field>
        <field name="model">g2p.livestock.registry.line</field>
        <field name="arch" type="xml">
            <pivot string="Demographic Analytics" sample="1">
                <field name="species_id" type="col"/>        <!-- Updated -->
                <field name="breed" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_g2p_livestock_registry_dashboard" model="ir.actions.act_window">
        <field name="name">Livestock Statistics</field>
        <field name="res_model">g2p.livestock.registry.line</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="context">{'search_default_group_species': 1}</field>
    </record>

    <record id="action_g2p_livestock_registry_vaccination_dashboard" model="ir.actions.act_window">
        <field name="name">Vaccination Compliance</field>
        <field name="res_model">g2p.livestock.registry.line</field>
        <field name="view_mode">graph,pivot,tree</field>
    </record>

    <record id="action_g2p_livestock_registry_demographics" model="ir.actions.act_window">
        <field name="name">Demographic Analytics</field>
        <field name="res_model">g2p.livestock.registry.line</field>
        <field name="view_mode">pivot,graph,tree</field>
    </record>

    <!-- Recent Vital Events feed -->
    <record id="action_g2p_livestock_recent_vital_events" model="ir.actions.act_window">
        <field name="name">Recent Vital Events</field>
        <field name="res_model">g2p.livestock.vital.event</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>