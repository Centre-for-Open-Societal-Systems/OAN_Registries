<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="g2p_livestock_audit_log_tree" model="ir.ui.view">
        <field name="name">g2p.livestock.audit.log.tree</field>
        <field name="model">g2p.livestock.audit.log</field>
        <field name="arch" type="xml">
            <tree string="Audit Logs" create="0" edit="0" delete="0">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="user_role"/>
                <field name="action_type"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="changes"/>
                <field name="ip_address"/>
            </tree>
        </field>
    </record>

    <record id="g2p_livestock_audit_log_form" model="ir.ui.view">
        <field name="name">g2p.livestock.audit.log.form</field>
        <field name="model">g2p.livestock.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="user_role"/>
                            <field name="action_type"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="ip_address"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="changes" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="g2p_livestock_audit_log_search" model="ir.ui.view">
        <field name="name">g2p.livestock.audit.log.search</field>
        <field name="model">g2p.livestock.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Logs">
                <field name="user_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="action_type"/>
                <filter name="filter_create" string="Create" domain="[('action_type', '=', 'create')]"/>
                <filter name="filter_update" string="Update" domain="[('action_type', '=', 'update')]"/>
                <filter name="filter_import" string="Import" domain="[('action_type', '=', 'import')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_action" string="Action Type" context="{'group_by': 'action_type'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_g2p_livestock_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">g2p.livestock.audit.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="g2p_livestock_audit_log_search"/>
        <field name="context">{'search_default_filter_update': 1}</field>
    </record>
</odoo>
