<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_g2p_livestock_import_batch_tree" model="ir.ui.view">
        <field name="name">g2p.livestock.import.batch.tree</field>
        <field name="model">g2p.livestock.import.batch</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'failed'" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="source_system"/>
                <field name="state" widget="badge"/>
                <field name="total_rows"/>
                <field name="success_count"/>
                <field name="failure_count"/>
                <field name="conflict_count"/>
                <field name="processed_by"/>
                <field name="processing_date"/>
            </tree>
        </field>
    </record>

    <record id="view_g2p_livestock_import_batch_form" model="ir.ui.view">
        <field name="name">g2p.livestock.import.batch.form</field>
        <field name="model">g2p.livestock.import.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_file" string="Process File" type="object"
                            class="oe_highlight" invisible="state == 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_system"/>
                            <field name="import_file" filename="import_filename"/>
                            <field name="import_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="processed_by" readonly="1"/>
                            <field name="processing_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Results" invisible="state != 'completed'">
                        <group>
                            <field name="total_rows"/>
                            <field name="success_count"/>
                        </group>
                        <group>
                            <field name="failure_count"/>
                            <field name="conflict_count"/>
                        </group>
                    </group>
                    <group string="Error / Conflict Log" invisible="not error_log">
                        <field name="error_log" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_g2p_livestock_import_batch" model="ir.actions.act_window">
        <field name="name">Import Data</field>
        <field name="res_model">g2p.livestock.import.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload a CSV or Excel (.xlsx) file to import or update livestock records in bulk.
            </p>
            <p>Expected columns: ear_tag_id, species, breed, farmer_id, registration_date, date_of_birth.
               Each row is one animal — animals belonging to the same farmer_id are automatically
               grouped under that farmer's existing record.</p>
        </field>
    </record>

    <menuitem id="menu_livestock_import_batch"
              name="Import Data"
              parent="g2p_livestock_registry_menu_item_id"
              action="action_g2p_livestock_import_batch"
              sequence="5"
              groups="g2p_livestock_registry.group_livestock_federal_admin,g2p_livestock_registry.group_livestock_regional_vet"/>

</odoo>
