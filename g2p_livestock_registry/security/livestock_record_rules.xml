<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Federal Admin: unrestricted (explicit allow-all so no other rule
             accidentally restricts them, since Odoo OR's rules within a group
             but the groups are not mutually exclusive here) -->
        <record id="rule_livestock_federal_admin_all" model="ir.rule">
            <field name="name">Livestock: Federal Admin sees all</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_livestock_federal_admin'))]"/>
        </record>

        <!-- Auditor: read-only full visibility (write/create/unlink blocked via access CSV) -->
        <record id="rule_livestock_auditor_all" model="ir.rule">
            <field name="name">Livestock: Auditor sees all (read-only)</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_livestock_auditor'))]"/>
        </record>

        <!-- Regional Vet Officer: scoped to their region (res.partner.region) -->
        <record id="rule_livestock_regional_vet_scope" model="ir.rule">
            <field name="name">Livestock: Regional Vet Officer regional scope</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">
                ['|', ('region_id', '=', False), ('region_id', '=', user.partner_id.region.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_livestock_regional_vet'))]"/>
        </record>

        <!-- Field Officer: scoped to their woreda -->
        <record id="rule_livestock_field_officer_scope" model="ir.rule">
            <field name="name">Livestock: Field Officer woreda scope</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">
                ['|', ('woreda_id', '=', False), ('woreda_id', '=', user.partner_id.woreda.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_livestock_field_officer'))]"/>
        </record>

        <!-- Hierarchical approval chain scopes: each approver only sees
             records within their own assigned location at that level. -->
        <record id="rule_livestock_kebele_approver_scope" model="ir.rule">
            <field name="name">Livestock: Kebele Approver scope</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">
                ['|', ('kebele_id', '=', False), ('kebele_id', '=', user.partner_id.kebele.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_livestock_kebele_approver'))]"/>
        </record>
        <record id="rule_livestock_woreda_approver_scope" model="ir.rule">
            <field name="name">Livestock: Woreda Approver scope</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">
                ['|', ('woreda_id', '=', False), ('woreda_id', '=', user.partner_id.woreda.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_livestock_woreda_approver'))]"/>
        </record>
        <record id="rule_livestock_zone_approver_scope" model="ir.rule">
            <field name="name">Livestock: Zone Approver scope</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">
                ['|', ('zone_id', '=', False), ('zone_id', '=', user.partner_id.zone.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_livestock_zone_approver'))]"/>
        </record>
        <record id="rule_livestock_region_approver_scope" model="ir.rule">
            <field name="name">Livestock: Region Approver scope</field>
            <field name="model_id" ref="model_g2p_livestock_registry"/>
            <field name="domain_force">
                ['|', ('region_id', '=', False), ('region_id', '=', user.partner_id.region.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_livestock_region_approver'))]"/>
        </record>

    </data>
</odoo>
