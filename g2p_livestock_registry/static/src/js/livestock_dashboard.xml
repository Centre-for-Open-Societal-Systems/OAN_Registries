<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="g2p_livestock_registry.LivestockDashboard">
<div class="ld-root">

    <t t-if="state.loading">
        <div class="ld-center"><div class="ld-spinner"/></div>
    </t>

    <t t-elif="state.data">
        <t t-set="d" t-value="state.data"/>

        <!-- HEADER -->
        <div class="ld-header">
            <div>
                <h1 class="ld-title">🐄 Livestock Registry Dashboard</h1>
                <span class="ld-date">as of <t t-esc="d.as_of"/></span>
            </div>
            <div class="ld-hbtns">
                <button class="ld-btn-outline" t-on-click="() => this.loadData()">↻ Refresh</button>
                <button class="ld-btn-outline" t-on-click="() => this.exportReport()">⬇ Export Excel</button>
                <button class="ld-btn-outline" t-on-click="() => this.exportReportPdf()">⬇ Export PDF</button>
                <button class="ld-btn-solid" t-on-click="() => this.navTo([], 'All Records')">View All Records</button>
            </div>
        </div>

        <!-- FILTERS (LR-14) -->
        <t t-if="state.filterOptions">
            <div class="ld-filters">
                <select class="ld-filter-input" t-on-change="(ev) => this.onFilterChange('region_id', ev)">
                    <option value="">All Regions</option>
                    <t t-foreach="state.filterOptions.regions" t-as="r" t-key="r.id">
                        <option t-att-value="r.id" t-esc="r.name"/>
                    </t>
                </select>
                <select class="ld-filter-input" t-on-change="(ev) => this.onFilterChange('woreda_id', ev)">
                    <option value="">All Woredas</option>
                    <t t-foreach="state.filterOptions.woredas" t-as="w" t-key="w.id">
                        <option t-att-value="w.id" t-esc="w.name"/>
                    </t>
                </select>
                <select class="ld-filter-input" t-on-change="(ev) => this.onFilterChange('owner_id', ev)">
                    <option value="">All Owners</option>
                    <t t-foreach="state.filterOptions.owners" t-as="o" t-key="o.id">
                        <option t-att-value="o.id" t-esc="o.name"/>
                    </t>
                </select>
                <select class="ld-filter-input" t-on-change="(ev) => this.onFilterChange('species', ev)">
                    <option value="">All Species</option>
                    <t t-foreach="state.filterOptions.species" t-as="sp" t-key="sp.id">
                        <option t-att-value="sp.id" t-esc="sp.name"/>
                    </t>
                </select>
                <input type="date" class="ld-filter-input" placeholder="From"
                       t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
                <input type="date" class="ld-filter-input" placeholder="To"
                       t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
                <button class="ld-btn-solid" t-on-click="() => this.applyFilters()">Apply</button>
                <button class="ld-btn-outline" t-on-click="() => this.resetFilters()">Reset</button>
            </div>
        </t>

        <!-- ALERTS -->
        <t t-if="d.alerts.length">
            <div class="ld-alerts">
                <t t-foreach="d.alerts" t-as="a" t-key="a_index">
                    <div t-attf-class="ld-alert ld-alert-#{a.type}">
                        <t t-if="a.type === 'danger'">🔴</t>
                        <t t-if="a.type === 'warning'">🟡</t>
                        <t t-esc="a.msg"/>
                    </div>
                </t>
            </div>
        </t>

        <!-- KPI CARDS -->
        <div class="ld-kpis">

            <div class="ld-kpi" t-on-click="() => this.navTo([], 'All Records')">
                <div class="ld-kpi-top blue">
                    <span class="ld-kpi-icon">📋</span>
                </div>
                <div class="ld-kpi-body">
                    <div class="ld-kpi-num"><t t-esc="d.total_registries"/></div>
                    <div class="ld-kpi-lbl">Total Registrations</div>
                    <div class="ld-kpi-sub"><t t-esc="d.registered_last_7 ?? 0"/> added this week</div>
                </div>
            </div>

            <div class="ld-kpi" t-on-click="() => this.navTo([], 'All Animals')">
                <div class="ld-kpi-top green">
                    <span class="ld-kpi-icon">🐐</span>
                </div>
                <div class="ld-kpi-body">
                    <div class="ld-kpi-num"><t t-esc="d.total_animals"/></div>
                    <div class="ld-kpi-lbl">Total Animals</div>
                    <div class="ld-kpi-sub"><t t-esc="healthPct"/>% healthy</div>
                </div>
            </div>

            <div class="ld-kpi" t-on-click="() => this.navTo([['state','=','verified']], 'Verified')">
                <div class="ld-kpi-top indigo">
                    <span class="ld-kpi-icon">✅</span>
                </div>
                <div class="ld-kpi-body">
                    <div class="ld-kpi-num"><t t-esc="d.verified"/></div>
                    <div class="ld-kpi-lbl">Verified</div>
                    <div class="ld-kpi-sub"><t t-esc="d.draft"/> still in draft</div>
                </div>
            </div>

            <div class="ld-kpi" t-on-click="() => this.navTo([['state','=','draft']], 'Drafts')">
                <div class="ld-kpi-top amber">
                    <span class="ld-kpi-icon">📝</span>
                </div>
                <div class="ld-kpi-body">
                    <div class="ld-kpi-num"><t t-esc="d.draft"/></div>
                    <div class="ld-kpi-lbl">Pending Draft</div>
                    <div class="ld-kpi-sub">Awaiting verification</div>
                </div>
            </div>

            <div class="ld-kpi" t-on-click="() => this.navTo([], 'Vaccination')">
                <div class="ld-kpi-top teal">
                    <span class="ld-kpi-icon">💉</span>
                </div>
                <div class="ld-kpi-body">
                    <div class="ld-kpi-num"><t t-esc="vaxPct"/>%</div>
                    <div class="ld-kpi-lbl">Vaccination Coverage</div>
                    <div class="ld-kpi-sub"><t t-esc="d.vaccination.overdue"/> overdue</div>
                </div>
            </div>

            <div class="ld-kpi" t-on-click="() => this.navTo([['sync_status','=','conflict']], 'Sync Issues')">
                <div class="ld-kpi-top red">
                    <span class="ld-kpi-icon">⚠️</span>
                </div>
                <div class="ld-kpi-body">
                    <div class="ld-kpi-num"><t t-esc="d.sync.conflict + d.sync.pending"/></div>
                    <div class="ld-kpi-lbl">Sync Issues</div>
                    <div class="ld-kpi-sub"><t t-esc="d.sync.conflict"/> conflicts</div>
                </div>
            </div>

        </div>

        <!-- CHARTS + STATUS -->
        <div class="ld-middle">

            <!-- Health donut -->
            <div class="ld-card">
                <div class="ld-card-title">Health Status</div>
                <div class="ld-donut-wrap">
                    <canvas id="ld-health-chart" width="120" height="120"/>
                    <div class="ld-legend">
                        <div class="ld-leg"><span class="ld-dot" style="background:#22c55e"/>Healthy <b><t t-esc="d.health.healthy"/></b></div>
                        <div class="ld-leg"><span class="ld-dot" style="background:#f59e0b"/>Sick <b><t t-esc="d.health.sick"/></b></div>
                        <div class="ld-leg"><span class="ld-dot" style="background:#f97316"/>Quarantined <b><t t-esc="d.health.quarantined"/></b></div>
                        <div class="ld-leg"><span class="ld-dot" style="background:#ef4444"/>Deceased <b><t t-esc="d.health.deceased"/></b></div>
                    </div>
                </div>
            </div>

            <!-- Vaccination donut -->
            <div class="ld-card">
                <div class="ld-card-title">Vaccination Status</div>
                <div class="ld-donut-wrap">
                    <canvas id="ld-vax-chart" width="120" height="120"/>
                    <div class="ld-legend">
                        <div class="ld-leg"><span class="ld-dot" style="background:#3b82f6"/>Up to date <b><t t-esc="d.vaccination.up_to_date"/></b></div>
                        <div class="ld-leg"><span class="ld-dot" style="background:#f59e0b"/>Overdue <b><t t-esc="d.vaccination.overdue"/></b></div>
                        <div class="ld-leg"><span class="ld-dot" style="background:#e2e8f0"/>None <b><t t-esc="d.vaccination.none"/></b></div>
                    </div>
                </div>
            </div>

            <!-- Species breakdown -->
            <div class="ld-card">
                <div class="ld-card-title">Animals by Species</div>
                <div class="ld-species-list">
                    <t t-foreach="d.species_breakdown" t-as="sp" t-key="sp_index">
                        <div class="ld-sp-row">
                            <span class="ld-sp-lbl"><t t-esc="sp.label"/></span>
                            <div class="ld-sp-track">
                                <div class="ld-sp-fill"
                                     t-attf-style="width:#{d.total_animals ? Math.round(sp.count/d.total_animals*100) : 0}%; background:#{['#6366f1','#22c55e','#f59e0b','#3b82f6','#ef4444','#f97316'][sp_index % 6]}"/>
                            </div>
                            <span class="ld-sp-num"><t t-esc="sp.count"/></span>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Record + Sync status -->
            <div class="ld-card">
                <div class="ld-card-title">Record Status</div>
                <div class="ld-status-list">
                    <div class="ld-st green" t-on-click="() => this.navTo([['state','=','verified']], 'Verified')">
                        <span>Verified</span><b><t t-esc="d.verified"/></b>
                    </div>
                    <div class="ld-st blue" t-on-click="() => this.navTo([['state','=','draft']], 'Draft')">
                        <span>Draft</span><b><t t-esc="d.draft"/></b>
                    </div>
                    <div class="ld-st gray" t-on-click="() => this.navTo([['state','=','archived']], 'Archived')">
                        <span>Archived</span><b><t t-esc="d.archived"/></b>
                    </div>
                </div>
                <div class="ld-card-title" style="margin-top:16px">Sync Status</div>
                <div class="ld-status-list">
                    <div class="ld-st green"><span>Synced</span><b><t t-esc="d.sync.synced"/></b></div>
                    <div class="ld-st amber" t-on-click="() => this.navTo([['sync_status','=','pending']], 'Pending Sync')">
                        <span>Pending</span><b><t t-esc="d.sync.pending"/></b>
                    </div>
                    <div class="ld-st red" t-on-click="() => this.navTo([['sync_status','=','conflict']], 'Conflicts')">
                        <span>Conflict</span><b><t t-esc="d.sync.conflict"/></b>
                    </div>
                    <div class="ld-st red"><span>Failed</span><b><t t-esc="d.sync.failed"/></b></div>
                </div>
            </div>

        </div>

    </t>
</div>
</t>
</templates>