<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Fallback only: OAN IDs are normally generated from the Farmer
             Code + Farmer Name (see G2PLivestockRegistry._generate_oan_id).
             This sequence is used only if a record is created without any
             farmer information resolved yet. -->
        <record id="seq_g2p_livestock_registry" model="ir.sequence">
            <field name="name">Livestock Registry OAN ID (Fallback)</field>
            <field name="code">g2p.livestock.registry</field>
            <field name="prefix">OAN-%(year)s-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_g2p_livestock_import_batch" model="ir.sequence">
            <field name="name">Livestock Import Batch ID</field>
            <field name="code">g2p.livestock.import.batch</field>
            <field name="prefix">BATCH-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
