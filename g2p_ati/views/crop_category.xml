<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_crop_category_tree" model="ir.ui.view">
        <field name="name">view_crop.category.tree</field>
        <field name="model">g2p.crop.category</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
               <tree create="true" delete="true" edit="true">
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="view_crop_category_form" model="ir.ui.view">
        <field name="name">view_crop_category_form</field>
        <field name="model">g2p.crop.category</field>
        <field name="arch" type="xml">
            <form string="Crop Category">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="g2p_crop_category_tree_action" model="ir.actions.act_window">
        <field name="name">Crop Category</field>
        <field name="res_model">g2p.crop.category</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <menuitem
        id="g2p_crop_categorymenu"
        action="g2p_crop_category_tree_action"
        name="Crop Category"
        sequence="20"
        parent="menu_g2p_crop_root"
    />
</odoo>
