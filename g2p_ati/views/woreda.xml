<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_g2p_woreda_tree" model="ir.ui.view">
        <field name="name">view_g2p_woreda_tree</field>
        <field name="model">g2p.woreda</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
         <tree create="true" delete="true" edit="true">
                <field name="zone" required="1" />
                <field name="code" required="1" />
                <field name="name" required="1" />
                <field name="admin3_pcod" />
                <field name="admin3_refn" />
                <field name="admin3_altn" />
                <field name="admin3_al_1" />
                <field name="admin2_name" />
                <field name="admin2_pcod" />
                <field name="admin1_name" />
                <field name="admin1_pcod" />
                <field name="admin0_name" />
                <field name="admin0_pcod" />
                <field name="shape_length" />
                <field name="shape_area" />
                <field name="date" />
                <field name="valid_on" />
                <field name="valid_to" />
            </tree>
        </field>
    </record>

    <record id="view_g2p_woreda_form" model="ir.ui.view">
        <field name="name">view_g2p_woreda_form</field>
        <field name="model">g2p.woreda</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="zone" required="1" />
                            <field name="code" required="1" />
                            <field name="name" required="1" />
                            <field name="admin3_pcod" />
                            <field name="admin3_refn" />
                        </group>
                        <group>
                            <field name="admin3_altn" />
                            <field name="admin3_al_1" />
                            <field name="admin2_name" />
                            <field name="admin2_pcod" />
                            <field name="admin1_name" />
                            <field name="admin1_pcod" />
                            <field name="admin0_name" />
                            <field name="admin0_pcod" />
                            <field name="shape_length" />
                            <field name="shape_area" />
                            <field name="date" />
                            <field name="valid_on" />
                            <field name="valid_to" />
                        </group>
                    </group>
                    <group>
                        <field name="geom" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="g2p_woreda_view_tree_action" model="ir.actions.act_window">
        <field name="name">Woredas</field>
        <field name="res_model">g2p.woreda</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add an Farming Type!
                </p><p>
                    Click the create button to enter a new Farm type.
                </p>
            </field>
    </record>
    <menuitem
        id="g2p_woreda_menu"
        action="g2p_woreda_view_tree_action"
        name="Woredas"
        sequence="30"
        parent="menu_g2p_location_root"
    />
</odoo>
